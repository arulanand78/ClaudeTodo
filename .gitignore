# ============================================================
# ClaudeTodo — single root .gitignore
# Stack: React 19 + Vite (frontend/) and FastAPI + Python (backend/)
# ============================================================

# ---------- Node / frontend ----------
node_modules/
dist/
*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Vite
.vite/

# testing / coverage
coverage/

# ---------- Python / backend ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# packaging / build artifacts
build/
*.egg-info/
*.egg
.eggs/
develop-eggs/
sdist/
wheels/
pip-wheel-metadata/

# test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# Jupyter
.ipynb_checkpoints/

# ---------- SQLite (persistent todo store) ----------
*.db
*.db-journal
*.db-wal
*.db-shm

# ---------- Secrets / env ----------
.env
.env.*
!.env.example

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# ---------- Editors / IDEs ----------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project